  <TABLE ID="Table">
    <NAME>Fixed Targets</NAME>
    <TITLE>Fixed Targets for CFHT MEGACAM</TITLE>
    <!-- Definition of each field -->
    <FIELD name="NAME" datatype="A" width="20">
      <DESCRIPTION>Name of target</DESCRIPTION>
    </FIELD>
    <FIELD name="RA_J2000"    datatype="A" width="11" unit="h"   format="RAh:RAm:RAs">
      <DESCRIPTION>Right ascension of target</DESCRIPTION>
    </FIELD>
    <FIELD name="DEC_J2000"   datatype="A" width="12" unit="deg" format="DEd:DEm:DEs">
      <DESCRIPTION>Declination of target</DESCRIPTION>
    </FIELD>
    <FIELD name="MAG_AB" datatype="F" width="6">
      <DESCRIPTION>Magnitude (AB)</DESCRIPTION>
    </FIELD>
    <FIELD name="PM_RA"    datatype="F" width="6">
      <DESCRIPTION>Proper Motion RA (mas/yr)</DESCRIPTION>
    </FIELD>
    <FIELD name="PM_DEC"    datatype="F" width="6">
      <DESCRIPTION>Proper Motion DEC (mas/yr)</DESCRIPTION>
    </FIELD>
    <FIELD name="POINT_RA"    datatype="A" width="7" unit="deg"   format="RAm:RAs">
      <DESCRIPTION>Pointing Offset Right ascension of target</DESCRIPTION>
    </FIELD>
    <FIELD name="POINT_DEC"   datatype="A" width="8" unit="deg" format="DEm:DEs">
      <DESCRIPTION>Pointing Offset Declination of target</DESCRIPTION>
    </FIELD>
